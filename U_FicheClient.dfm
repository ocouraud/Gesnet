  object FDQueryTarifcli: TFDQuery
    MasterSource = DSClients
    MasterFields = 'CODCLI'
    DetailFields = 'CODCLI'
    Connection = DMGesCloud.ConnexionGesCloud
    SQL.Strings = (
      'SELECT '
      '  t.CODCLI, '
      '  t.CODART, '
      
        '  a.LIBELLE AS DESIGNATION,  -- Remplacez '#39'LIBELLE'#39' par le vrai ' +
        'nom du champ dans votre table article'
      '  t.PRIXVTE, '
      '  t.PRC_REMISE, '
      '  t.DER_MODIF '
      'FROM tarifcli t'
      'LEFT JOIN article a ON a.CODART = t.CODART'
      'WHERE t.CODCLI = :CODCLI')
    Left = 328
    Top = 424
    ParamData = <
      item
        Name = 'CODCLI'
        DataType = ftInteger
        ParamType = ptInput
        Value = 1
      end>
  end
  object FDQueryEntvteaa: TFDQuery
