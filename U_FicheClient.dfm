  object FDQueryCliinfocompl: TFDQuery
    AfterOpen = FDQueryCliinfocomplAfterOpen
    MasterSource = DSClients
    MasterFields = 'CODCLI'
    Connection = DMGesCloud.ConnexionGesCloud
    SQL.Strings = (
      
        'select * from cliinfocompl c, parinfocompl p, codinfocompl i whe' +
        're c.codcli = :CODCLI and p.type_='#39'C'#39' and p.id=c.id and i.type_=' +
        #39'C'#39' and i.id=c.id and i.codinfo=c.codinfo')
    Left = 452
    Top = 410
    ParamData = <
      item
        Name = 'CODCLI'
        ParamType = ptInput
      end>
  end
